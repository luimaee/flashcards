# Copy to .env.local and fill in values. Never commit .env.local.

# Which AI provider makes the cards.
#   mock  = no API, no network; cards are built from sentences in the material (default).
# Other providers will be added behind the same interface later.
AI_PROVIDER=mock

# Reserved for a future real provider. Leave empty in sample mode.
# Only a separately funded API key belongs here, never a personal login or session token.
# AI_API_KEY=
