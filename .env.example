# Copy to .env.local and fill in values. Never commit .env.local.

# Which provider makes the cards.
#   mock      = no API, no network; cards are built from sentences in the material (default).
#   anthropic = Claude API. Lecture text is sent to Anthropic to write the cards.
AI_PROVIDER=mock

# Required when AI_PROVIDER=anthropic. A separately funded API key from
# https://console.anthropic.com/ . Never a personal login, session or OAuth token.
# ANTHROPIC_API_KEY=

# Optional. Model used by the anthropic provider. Defaults to claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5

# Optional. Only for testing against a proxy or a fake endpoint.
# ANTHROPIC_BASE_URL=
